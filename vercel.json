{
  "functions": {
    "api/send-sms.js": {
      "runtime": "@vercel/node@2.15.1",
      "memory": 128
    },
    "api/send-email.js": {
      "runtime": "@vercel/node@2.15.1",
      "memory": 128
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
